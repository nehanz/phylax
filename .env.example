# Docker Compose Profiles
# Set to 'postgres' to run Postgres in Docker. Leave empty if using Supabase/external DB.
COMPOSE_PROFILES=postgres

# Database Configuration
# Local dev outside Docker: jdbc:postgresql://localhost:5432/phylax
# Supabase: jdbc:postgresql://<host>:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/phylax
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
POSTGRES_DB=phylax
POSTGRES_PORT=5432

# Used by Docker containers when connecting to local Docker postgres
DOCKER_DATABASE_URL=jdbc:postgresql://postgres:5432/phylax

# Kafka Configuration
# Host/Local access:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
# Docker container-to-container access:
DOCKER_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Redis Configuration
# Host/Local access: localhost. Docker access: redis (or external URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
DOCKER_REDIS_HOST=redis

# ClickHouse Configuration
# Host/Local access:
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/default
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9009
# Docker container-to-container access:
DOCKER_CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/default

# Service Ports
API_GATEWAY_PORT=8080
CORE_SERVICE_PORT=8081
INGESTION_SERVICE_PORT=8082
ANALYTICS_SERVICE_PORT=8083
BEHAVIOR_ENGINE_PORT=8085

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
